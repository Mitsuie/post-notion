# Notion API Credentials
# Notionの「内部インテグレーションシークレット」（secret_... または ntn_...）
NOTION_API_KEY=""

# 投稿を保存するPostsデータベースのID（32桁の英数字）
NOTION_POSTS_DATABASE_ID=""

# タグ管理データベースのID（任意 / 32桁の英数字）
NOTION_TAGS_DATABASE_ID=""

# タグの選択上限（任意）
# Posts DB のタグリレーションを1件に制限している場合は 1 を指定。未指定時は無制限
NOTION_TAGS_LIMIT=""

# 日報管理データベースのID（32桁の英数字）
NOTION_DAILY_REPORT_DATABASE_ID=""
