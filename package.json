    "dotenv": "^18.0.9",
    "hono": "^4.13.16",
    "lucide-react": "^1.70.0",
    "notion-to-md": "^3.1.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261107.1",
